<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Screens</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Screens</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.video</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>MXUGitCommit</key>
	<string>$(MXU_GIT_COMMIT)</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Screens asks Keynote to export decks so they can be imported.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Screens can fire slides and macros when events on your calendar start.</string>
	<key>NSCameraUsageDescription</key>
	<string>Screens shows cameras and capture devices on your screens as live video inputs.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Screens uses your local network to discover and receive NDI video sources, and announces its Local API so remotes and control surfaces can find this Mac.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Screens can include a capture device's audio when it is used as a live input.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Screens listens to a microphone you choose to follow lyrics and spot Bible references.</string>
</dict>
</plist>
